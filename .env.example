# Copie este arquivo para ".env" (ignorado pelo Git). Variáveis EXPO_PUBLIC_* são embutidas no app.
# URL da API do LongeVida:
#  - Emulador Android:         http://10.0.2.2:8080
#  - Simulador iOS / web:      http://localhost:8080
#  - Celular físico (Expo Go): http://SEU_IP_NA_REDE:8080   (ex.: http://192.168.0.10:8080)
#  - Produção: use SEMPRE https://
EXPO_PUBLIC_API_URL=http://localhost:8080
